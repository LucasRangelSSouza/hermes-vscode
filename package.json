{
  "name": "hermes-by-rangel-tech",
  "displayName": "Hermes by Rangel Tech",
  "description": "A community VS Code integration for Hermes Agent with a managed portable runtime, provider setup and synchronized skills. Not affiliated with Nous Research.",
  "version": "0.1.2",
  "publisher": "lucasrangel",
  "author": {
    "name": "Rangel Tech",
    "email": "comercial@rangeltech.net",
    "url": "https://github.com/LucasRangelSSouza/hermes-vscode"
  },
  "contributors": [
    {
      "name": "Joao Peixoto",
      "url": "https://github.com/joaompfp"
    },
    {
      "name": "Stefan van Biljon",
      "url": "https://github.com/stefanpieter"
    }
  ],
  "license": "MIT",
  "keywords": [
    "ai agent",
    "coding assistant",
    "autonomous agent",
    "claude",
    "codex",
    "copilot alternative",
    "pair programmer",
    "llm",
    "tool use",
    "chat",
    "hermes",
    "acp",
    "agent client protocol",
    "sidebar chat",
    "streaming"
  ],
  "homepage": "https://github.com/LucasRangelSSouza/hermes-vscode",
  "bugs": {
    "url": "https://github.com/LucasRangelSSouza/hermes-vscode/issues",
    "email": "comercial@rangeltech.net"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LucasRangelSSouza/hermes-vscode"
  },
  "icon": "resources/hermes-logo-128.png",
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "AI",
    "Chat",
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Hermes launches an autonomous local agent with access to the current workspace."
    }
  },
  "qna": "https://github.com/LucasRangelSSouza/hermes-vscode/issues",
  "contributes": {
    "commands": [
      {
        "command": "hermesRangelTech.openChat",
        "title": "Hermes: Open Chat"
      },
      {
        "command": "hermesRangelTech.newSession",
        "title": "Hermes: New Session"
      },
      {
        "command": "hermesRangelTech.setup",
        "title": "Hermes: Setup (Runtime and Provider)"
      },
      {
        "command": "hermesRangelTech.configureProvider",
        "title": "Hermes: Configure Provider",
        "icon": "$(gear)"
      },
      {
        "command": "hermesRangelTech.testConnection",
        "title": "Hermes: Test Provider Connection"
      },
      {
        "command": "hermesRangelTech.installRuntime",
        "title": "Hermes: Install or Repair Runtime"
      },
      {
        "command": "hermesRangelTech.selectPortableRuntime",
        "title": "Hermes: Select Portable Runtime Folder"
      },
      {
        "command": "hermesRangelTech.runtimeStatus",
        "title": "Hermes: Show Runtime Status"
      },
      {
        "command": "hermesRangelTech.configureSkills",
        "title": "Hermes: Configure Skills Sync"
      },
      {
        "command": "hermesRangelTech.syncSkills",
        "title": "Hermes: Sync Skills Now"
      },
      {
        "command": "hermesRangelTech.selectProfile",
        "title": "Hermes: Select Profile"
      },
      {
        "command": "hermesRangelTech.selectEditApprovalMode",
        "title": "Hermes: Select Edit Approval Mode"
      },
      {
        "command": "hermesRangelTech.restartAgent",
        "title": "Hermes: Restart Agent"
      },
      {
        "command": "hermesRangelTech.showLogs",
        "title": "Hermes: Show Logs"
      },
      {
        "command": "hermesRangelTech.remoteLogin",
        "title": "Hermes: Sign In to RIA Atendimento (Remote Control)",
        "icon": "$(sign-in)"
      },
      {
        "command": "hermesRangelTech.remoteLogout",
        "title": "Hermes: Sign Out of RIA Atendimento",
        "icon": "$(sign-out)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "hermesRangelTech.configureProvider",
          "when": "view == hermesRangelTech.chatView",
          "group": "navigation@2"
        },
        {
          "command": "hermesRangelTech.remoteLogin",
          "when": "view == hermesRangelTech.chatView && !hermesRangelTech.remotePaired",
          "group": "navigation@1"
        },
        {
          "command": "hermesRangelTech.remoteLogout",
          "when": "view == hermesRangelTech.chatView && hermesRangelTech.remotePaired",
          "group": "navigation@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hermesRangelTech",
          "title": "Hermes",
          "icon": "resources/hermes-icon.png"
        }
      ]
    },
    "views": {
      "hermesRangelTech": [
        {
          "type": "webview",
          "id": "hermesRangelTech.chatView",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "Hermes by Rangel Tech",
      "properties": {
        "hermesRangelTech.runtime.mode": {
          "type": "string",
          "enum": [
            "automatic",
            "portable",
            "existing"
          ],
          "enumDescriptions": [
            "Download and manage the Hermes runtime automatically (recommended).",
            "Use a runtime folder you copied to this machine (for networks that block the download).",
            "Use a Hermes binary you already installed."
          ],
          "default": "automatic",
          "scope": "machine-overridable",
          "description": "How the extension finds Hermes."
        },
        "hermesRangelTech.runtime.portablePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Absolute path to a portable runtime folder (portable mode). Change it with Hermes: Select Portable Runtime Folder."
        },
        "hermesRangelTech.runtime.existingPath": {
          "type": "string",
          "default": "hermes",
          "scope": "machine-overridable",
          "description": "Trusted absolute path to an existing Hermes binary (existing mode)."
        },
        "hermesRangelTech.runtime.optionalPacks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "browser",
            "media",
            "computer-use",
            "llm-cpu",
            "llm-cuda",
            "llm-hip",
            "llm-vulkan",
            "cli-tools",
            "offline-cache"
          ],
          "scope": "machine-overridable",
          "description": "Optional runtime packs to install with the core runtime. The default installs everything."
        },
        "hermesRangelTech.profile": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Optional Hermes profile to use for ACP sessions. Empty uses Hermes's current/default profile."
        },
        "hermesRangelTech.editApprovalMode": {
          "type": "string",
          "enum": [
            "default",
            "accept_edits",
            "dont_ask"
          ],
          "enumDescriptions": [
            "Ask before every file edit.",
            "Automatically allow workspace and temporary-file edits, while still asking for sensitive paths.",
            "Automatically allow file edits for the session except sensitive paths."
          ],
          "default": "dont_ask",
          "scope": "machine-overridable",
          "description": "ACP file-edit approval mode. Change it with Hermes: Select Edit Approval Mode."
        },
        "hermesRangelTech.autoApprovePermissions": {
          "type": "boolean",
          "default": true,
          "scope": "machine-overridable",
          "description": "Auto-allow Hermes tool/permission requests (including terminal commands) by default, instead of showing a confirmation for each one. Turn this off to review and approve every action yourself. This default favors an agent that keeps working without waiting on you; it also avoids known cases where a self-hosted model's own internal approval step can stall a turn (docs/agentic-reliability-debug.md)."
        },
        "hermesRangelTech.debugLogs": {
          "type": "boolean",
          "default": false,
          "description": "Enable diagnostic ACP logs in the Hermes output channel."
        },
        "hermesRangelTech.skills.repository": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "GitHub repository with your Hermes skills, as owner/repo. Change it with Hermes: Configure Skills Sync. The token is kept in Secret Storage."
        },
        "hermesRangelTech.skills.branch": {
          "type": "string",
          "default": "main",
          "scope": "machine-overridable",
          "description": "Branch to sync."
        },
        "hermesRangelTech.skills.path": {
          "type": "string",
          "default": "skills",
          "scope": "machine-overridable",
          "description": "Folder inside the repository that holds the skills."
        },
        "hermesRangelTech.skills.syncOnStartup": {
          "type": "boolean",
          "default": true,
          "scope": "machine-overridable",
          "description": "Sync the skills repository when VS Code starts."
        },
        "hermesRangelTech.skills.syncBeforeLaunch": {
          "type": "boolean",
          "default": true,
          "scope": "machine-overridable",
          "description": "Sync the skills repository just before Hermes starts (with a 20 second limit)."
        },
        "hermesRangelTech.remote.baseUrl": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Base URL of the Agent LLM (RIA Atendimento) backend for Hermes remote control. Empty disables remote control entirely."
        },
        "hermesRangelTech.remote.deviceName": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Friendly name shown for this computer in the RIA Hermes agente view. Empty uses the computer's hostname."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "webpack --mode production",
    "lint": "tsc --noEmit",
    "secrets": "secretlint --secretlintrc .secretlintrc.json \"*.{md,json,js,ts,yml,yaml}\" \"src/**/*.{ts,json}\" \"scripts/**/*.{js,mjs,cjs,ts}\" \"tests/**/*.ts\" \".github/**/*.{md,yml,yaml}\" \"docs/**/*.md\" \"resources/**/*.md\"",
    "test": "npm run test:profile && npm run test:background && npm run test:audit-policy",
    "posttest": "node -e \"require('node:fs').rmSync('out-test', { recursive: true, force: true })\"",
    "dev": "webpack --mode development --watch",
    "package": "vsce package --no-dependencies",
    "package:verify": "npm run package -- --out hermes-by-rangel-tech-ci.vsix && vsce ls",
    "audit": "node scripts/audit-all-locked.mjs",
    "verify": "npm run lint && npm run secrets && npm test && npm run build && npm run audit && npm run package:verify",
    "test:profile": "tsc --module commonjs --target ES2020 --types node --skipLibCheck --esModuleInterop --strict --outDir out-test tests/acpLaunchArgs.test.ts tests/profileUi.test.ts src/acpLaunchArgs.ts src/profileUi.ts && node out-test/tests/acpLaunchArgs.test.js && node out-test/tests/profileUi.test.js",
    "test:background": "node scripts/run-background-tests.mjs",
    "test:audit-policy": "node --test scripts/audit-all-locked.test.mjs"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.6",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.6.4",
    "@types/vscode": "^1.140.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "secretlint": "^13.0.6",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "marked": "^17.0.6",
    "tar": "^7.4.3"
  }
}
